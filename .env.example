APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Media and channel files are served as absolute URLs built from APP_URL, so it must match the host and port
# the app is actually reached on (php artisan serve uses http://localhost:8000).
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL, not SQLite: the activity log is partitioned by year on MySQL (2026_09_03_130000), which SQLite skips.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=backoffice_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Invitations and password resets both live or die on these.
#
# MAIL_MAILER=log means the email is written to storage/logs/laravel.log and
# NOBODY receives it. That is fine locally and useless in production.
#
# For a real inbox set MAIL_MAILER=smtp and fill in what your provider gave you,
# for example:
#   MAIL_MAILER=smtp
#   MAIL_HOST=smtp.your-provider.com
#   MAIL_PORT=587
#   MAIL_SCHEME=tls
#   MAIL_USERNAME=your-smtp-username
#   MAIL_PASSWORD=your-smtp-password
#
# MAIL_FROM_ADDRESS must be an address on a domain YOU own. Providers reject a
# From address you cannot prove is yours, and that rejection is the single most
# common reason invitation and reset emails never arrive.
#
# After changing these, prove it works:  php artisan mail:test you@example.com
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Initial super admin password used by the database seeder (random + printed once if unset)
SEED_ADMIN_PASSWORD=

# How often a screen breaks for network advertising, in seconds (config/signage.php; 3600 by default, 6 under Dusk)
# SIGNAGE_AD_BREAK_SECONDS=3600
