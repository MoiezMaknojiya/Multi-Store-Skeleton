# The live server's settings (deploy/README.md). setup.sh copies this file to /var/www/signage/shared/.env
# with the domain, a random app key and the database password already filled in. Fill in every __FILL_IN__
# yourself, on the server:   nano /var/www/signage/shared/.env
# A deploy refuses to run while one is left. Keep the quotes around anything with a space in it.
# Editing this file later changes nothing until the cache is rebuilt:
#   cd /var/www/signage/current && php artisan optimize

# The name shown in the sidebar, the TV player's title and every email.
APP_NAME="__FILL_IN__"
# production + false: no error details for visitors, and Dusk's sign-in route cannot exist (deploy.sh checks).
APP_ENV=production
APP_KEY=__APP_KEY__
APP_DEBUG=false
APP_URL=https://__DOMAIN__

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# One file a day in storage/logs, two weeks kept; only warnings and errors.
LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
# Through MySQL's own socket on this server (setup.sh fills in where it is) rather than the network.
DB_SOCKET=__DB_SOCKET__
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=signage
DB_USERNAME=signage
DB_PASSWORD=__DB_PASSWORD__

# In the database: deleting an account signs that person out on every device (User::booted()).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# The session cookie travels over HTTPS only — so sign in only once certbot has run.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Nothing is queued in this app: sync sends each email at once and needs no worker running.
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Invitations and password resets go out through Brevo (brevo.com → SMTP & API → SMTP): the SMTP login and
# an SMTP key (not an API key). Port 587 — Hetzner blocks 25 and 465 on a new server.
# MAIL_FROM_ADDRESS must be on a domain you own, added and authenticated in Brevo (Senders & domains), or
# the mail is refused or lands in spam. Test it after the deploy:  php artisan mail:test you@example.com
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=__FILL_IN__
MAIL_PASSWORD=__FILL_IN__
MAIL_FROM_ADDRESS=__FILL_IN__
MAIL_FROM_NAME="${APP_NAME}"

# The first super admin, made by the first deploy (deploy.sh --first) — your own email and a strong password
# of at least 12 characters. Once you have signed in, empty the password line again:
#   SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=__FILL_IN__
SEED_ADMIN_PASSWORD=__FILL_IN__

# How often a screen breaks for network advertising, in seconds (config/signage.php).
SIGNAGE_AD_BREAK_SECONDS=3600
